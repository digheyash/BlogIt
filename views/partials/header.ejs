<header class="p-3 text-bg-dark"> 
    <div class="container"> 
        <!-- justify-content-between spreads out the 3 sections evenly -->
        <div class="d-flex flex-wrap align-items-center justify-content-between py-3"> 
            
            <!-- 1. Left Spacer (Takes up equal space to keep the middle centered) -->
            <div class="col-md-3 mb-2 mb-md-0"></div>
            
            <!-- 2. Center Column (Your Blog Title) -->
            <ul class="nav col-12 col-md-auto justify-content-center mb-2 mb-md-0"> 
                <li>
                    <a href="#" id="about-link" class="nav-link px-3 text-white fw-bold fs-2">My Blog</a>
                </li>
            </ul>
            
            <!-- 3. Right Column (Buttons) -->
            <div class="col-12 col-md-3 text-center text-md-end mt-3 mt-md-0">
                <button type="button" class="btn btn-outline-light me-2 my-2">Login</button>
                <button type="button" class="btn btn-warning">Sign-up</button>
            </div>
            
        </div>
    </div>
</header>